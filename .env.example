OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OpenRouter provider slug for DeepInfra.
OPENROUTER_PROVIDER=deepinfra
# Keep false to fail explicitly instead of silently using another provider.
OPENROUTER_ALLOW_FALLBACKS=false
# Reject providers that cannot honor response_format/reasoning parameters.
OPENROUTER_REQUIRE_PARAMETERS=true
# Optional attribution headers. Set a real production URL when available.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=IDX Disclosure Digest

IDX_BASE_URL=https://www.idx.co.id
IDX_PAGE_SIZE=50
IDX_REQUEST_DELAY_SECONDS=0.35
IDX_USER_AGENT=IDXDisclosureDigest/0.15.5 (+your-email@example.com)
# Only set this if IDX begins requiring a browser session. Never commit it.
IDX_COOKIE=

# auto: try HTTP first, then open Chromium on Cloudflare 403
# browser: always use Chromium
# http: never use Chromium
IDX_TRANSPORT=auto
IDX_BROWSER_PROFILE_DIR=./data/browser-profile
IDX_BROWSER_HEADLESS=false
IDX_BROWSER_NAVIGATION_TIMEOUT_MS=60000
IDX_BROWSER_VERIFICATION_TIMEOUT_SECONDS=180

APP_TIMEZONE=Asia/Jakarta
DATA_DIR=./data
OCR_LANG=ind+eng
OCR_MIN_CHARS_PER_PAGE=80
MAX_XLSX_CELLS=250000
LLM_CHUNK_CHARS=45000
